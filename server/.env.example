# Server configuration
PORT=4000

# MongoDB connection string (required — server fails fast if missing in production)
MONGODB_URI=mongodb://127.0.0.1:27017/askly

# Origin allowed by CORS and Socket.io (the client dev server)
CLIENT_ORIGIN=http://localhost:5173

# --- Auth (v2) ---
# REQUIRED. Signs JWTs. Must be at least 32 characters (server fails fast otherwise).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Token lifetime (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d
# Google OAuth client ID (optional). If unset, Google sign-in is disabled (endpoint 503).
GOOGLE_CLIENT_ID=
# bcrypt password hashing cost
BCRYPT_ROUNDS=10

# --- Quiz (v2) ---
QUIZ_POINTS_PER_CORRECT=100
QUIZ_MAX_PLAYERS=200

# --- Anti-spam limits (all optional; sensible defaults in config/env.js) ---
# Socket token buckets (per identity / per IP, per minute)
RL_QUESTIONS_PER_MIN=5
RL_UPVOTES_PER_MIN=30
RL_VOTES_PER_MIN=20
RL_QUIZ_ANSWERS_PER_MIN=120
# REST room creation (now per USER, per hour)
RL_ROOM_CREATE_PER_HOUR=30
# Auth: requests per IP / failed logins per email, each per 15 minutes
RL_AUTH_PER_15MIN=60
RL_LOGIN_FAILS_PER_15MIN=10
# Reject identical question text from same room within this window (ms)
DUPLICATE_QUESTION_WINDOW_MS=30000
# Max concurrent sockets per IP per room (v2: now just a flood guard — raised for campus Wi-Fi)
MAX_SOCKETS_PER_IP_PER_ROOM=300
# analytics:updated throttle (ms)
ANALYTICS_THROTTLE_MS=2000
