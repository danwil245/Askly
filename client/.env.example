# Base URL for the REST API and Socket.io server.
# Leave blank to use the Vite dev proxy (same-origin /api + /socket.io).
# In production set this to your deployed server origin, e.g. https://askly-server.onrender.com
VITE_API_URL=

# Google OAuth client ID (optional). If unset, the Google sign-in button is hidden.
# Must match GOOGLE_CLIENT_ID on the server. See README for setup steps.
VITE_GOOGLE_CLIENT_ID=
